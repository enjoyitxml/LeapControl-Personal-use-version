<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件左上角的车标（个人学习版专用）：方向盘。

  为什么不直接用 `ic_ac_steering`：那是空调页的 24dp **线性**图标，笔画在 24 视口里
  只有 1.2px，缩到小组件的 14dp 只剩 0.7dp，浅色卡片上几乎看不见。
  这里按小组件的实际观感重画成**实心**：外圈粗环 + 中心毂 + 三根辐条，
  环厚 4.2/24（14dp 下约 2.5dp），与左侧 20sp 半粗体车名同一个重量级。

  颜色由 RemoteViews 的 `setColorFilter` 注入（跟随卡片底色），所以这里只画形状。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 外圈 + 内圈挖空（evenOdd 形成圆环） -->
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M12 0.8a11.2 11.2 0 1 0 0 22.4a11.2 11.2 0 1 0 0-22.4zM12 5.02a6.98 6.98 0 1 1 0 13.96a6.98 6.98 0 1 1 0-13.96z" />

    <!-- 三根辐条：左右水平、正下 -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M1.2 10.4h9.3v3H1.2z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M13.5 10.4h9.3v3h-9.3z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M10.5 10.4h3v11.6h-3z" />

    <!-- 中心毂 -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M12 9.2a3.1 3.1 0 1 0 0 6.2a3.1 3.1 0 1 0 0-6.2z" />
</vector>
