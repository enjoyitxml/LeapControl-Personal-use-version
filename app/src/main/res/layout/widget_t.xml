<?xml version="1.0" encoding="utf-8"?>
<!--
  T｜全透明 —— 没有卡片底，字和按键直接浮在壁纸上。

  版式与 A 素纸完全一致（标题行 / 续航 / 右侧车模 / 底部五格），差别只有三处：
    ① 根背景透明（`@android:color/transparent`），壁纸从卡片里透出来；
    ② 文字带一层黑色阴影 —— 壁纸深浅不可控，纯靠字色对比在浅壁纸上会糊；
    ③ 分隔线、按键底的填充色都交给代码在运行时上色 / 换素材，
       因为它们要跟着用户选的「字体颜色 / 控件颜色」走。

  进度条为什么是两层：
    ProgressBar 只能改 progress 值，**没有** setProgressDrawable(int) 这种运行时换图的签名
    （RemoteViews 的 setInt 反射调用会直接失败）。所以「浅色字配亮条、深色字配暗条」
    只能靠两份 drawable + 两条 ProgressBar 叠在同一个位置、由代码显示其中一条。
    FrameLayout 只定高 12dp（宽度随行伸展），外层间距也挪到了它身上，
    所以对齐关系和 A 版一模一样。

  续航行的对齐口径与 A 版完全相同：里程是一个 TextView（「195km」数字与单位连写、贴左起排），
  列宽 wrap_content + minWidth 46dp（宽版 52dp），条 0dp + weight=1，百分比右对齐 ——
  两行的数字左缘、条的起点与末端、百分号各成一条竖线。

  分隔线给了四个独立 id（wg_div1~wg_div4）：RemoteViews 的 findViewById 只能命中
  第一个同 id 的视图，四个共用一个 id 的话只有第一条能上色。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingTop="9dp"
        android:paddingEnd="11dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/wg_hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/wg_info"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.06"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 车标格 18dp 是**容器**、不是图形：留白由 WidgetMetrics.logoPad 收放，
                         1.0（默认）时图形仍是 14dp，左缘与车名基线都不动。 -->
                    <ImageView
                        android:id="@+id/wg_logo"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="1dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_logo_steering" />

                    <TextView
                        android:id="@+id/wg_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="#59000000"
                        android:shadowDx="0"
                        android:shadowDy="1.2"
                        android:shadowRadius="4"
                        android:text="我的爱车"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/wg_ev_icon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_range_ev" />

                        <TextView
                            android:id="@+id/wg_ev_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:minWidth="46dp"
                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="--"
                            android:autoSizeTextType="none"
                            android:textColor="#FFFFFF"
                            android:shadowColor="#59000000"
                            android:shadowDx="0"
                            android:shadowDy="1.2"
                            android:shadowRadius="4"
                            android:textSize="13sp" />

                        <!-- 条的「槽」：定高 12dp，实际粗细由**这层盒子的上下内边距**收回
                             （见 WidgetMetrics.barPaddingPx）。内边距不能加在 ProgressBar 自己身上 ——
                             ProgressBar 只把 drawable 收到内容区顶部，条会整体上移 2~3dp，
                             文字一放大就和条不在同一条中线上（2026-11-09 用户截图反馈）。 -->
                        <FrameLayout
                            android:id="@+id/wg_ev_bar_box"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="12dp"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="2dp">

                            <ProgressBar
                                android:id="@+id/wg_ev_bar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progressDrawable="@drawable/widget_bar_ev_t" />

                            <ProgressBar
                                android:id="@+id/wg_ev_bar_dark"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progressDrawable="@drawable/widget_bar_ev_t_dark"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/wg_ev_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:minWidth="34dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:shadowColor="#59000000"
                            android:shadowDx="0"
                            android:shadowDy="1.2"
                            android:shadowRadius="4"
                            android:text="--"
                            android:autoSizeTextType="none"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/wg_fuel_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/wg_fuel_icon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_range_fuel" />

                        <TextView
                            android:id="@+id/wg_fuel_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:minWidth="46dp"
                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="--"
                            android:autoSizeTextType="none"
                            android:textColor="#FFFFFF"
                            android:shadowColor="#59000000"
                            android:shadowDx="0"
                            android:shadowDy="1.2"
                            android:shadowRadius="4"
                            android:textSize="13sp" />

                        <FrameLayout
                            android:id="@+id/wg_fuel_bar_box"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="12dp"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="2dp">

                            <ProgressBar
                                android:id="@+id/wg_fuel_bar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progressDrawable="@drawable/widget_bar_fuel_t" />

                            <ProgressBar
                                android:id="@+id/wg_fuel_bar_dark"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progressDrawable="@drawable/widget_bar_fuel_t_dark"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/wg_fuel_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:minWidth="34dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:shadowColor="#59000000"
                            android:shadowDx="0"
                            android:shadowDy="1.2"
                            android:shadowRadius="4"
                            android:text="--"
                            android:autoSizeTextType="none"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/wg_car_box"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/wg_car"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="车辆"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_act_row"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/wg_cell_unlock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_t"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wg_icon_unlock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="解锁"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qc_unlock" />
            </LinearLayout>

            <ImageView
                android:id="@+id/wg_div1"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#1FFFFFFF"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/wg_cell_lock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_t"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wg_icon_lock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="上锁"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qc_lock" />
            </LinearLayout>

            <ImageView
                android:id="@+id/wg_div2"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#1FFFFFFF"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/wg_cell_ac"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_t"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wg_icon_ac"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="空调"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_ac_fan" />
            </LinearLayout>

            <ImageView
                android:id="@+id/wg_div3"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#1FFFFFFF"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/wg_cell_trunk"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_t"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wg_icon_trunk"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="后备箱"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qc_trunk" />
            </LinearLayout>

            <ImageView
                android:id="@+id/wg_div4"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#1FFFFFFF"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/wg_cell_horn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_t"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wg_icon_horn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="鸣笛寻车"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qc_horn" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wg_status_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <!-- 状态图标（2026-11-20）：充电中闪电、解锁开锁、后备箱… 跟右边文字同色，
             由 VehicleWidget.bindLive 按 WidgetStatusText 给的语义设图与染色；
             更新时间 / 尚未同步这类提示不给图标，运行时 GONE。
             13dp 是量出来的：线稿图形只占 24 视口的 ~72%，乘下来正好 9.4dp，
             与旁边 10sp 的字等高；别再按「字号就是图标框」写成 10dp，那样图形只有 7dp。 -->
        <ImageView
            android:id="@+id/wg_hint_icon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_hint_ok"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wg_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:maxWidth="118dp"
            android:shadowColor="#59000000"
            android:shadowDx="0"
            android:shadowDy="1.2"
            android:shadowRadius="4"
            android:text="尚未同步"
            android:textColor="#E6FFFFFF"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/wg_refresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="3dp"
            android:clickable="true"
            android:contentDescription="刷新车况"
            android:focusable="true"
            android:padding="2.5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>
</FrameLayout>
