<?xml version="1.0" encoding="utf-8"?>
<!--
  D｜沉浸。

  和 A 同一套骨架，差别只在「底」：
    最底层 wg_bg 铺一张图（没选自定义图时是 widget_d_fallback 那段黄昏渐变）；
    下半部分压一层 widget_d_scrim（上透明、下 62% 黑），白字才读得清；
    按键改成半透明白玻璃格，压在任何照片上都不至于消失。

  图片走 setImageViewUri 交给桌面进程自己解码，不受 Binder 1MB 限制，
  圆角由根布局 clipToOutline 现裁，所以图片本身存成直角也不会露白边。

  续航行与 A 同口径（图标 · 里程 · 条 · 百分比，四件紧靠），只是条的颜色在照片上提亮一档：
  电 #3DD68C、油 #5AA9FF —— 保留「电绿油蓝」的语义，不至于退化成白色。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_light"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/wg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_dark"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/wg_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_d_scrim"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingTop="9dp"
        android:paddingEnd="11dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/wg_hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/wg_info"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.06"
                android:orientation="vertical">

                <!-- 标题行：logo + 车名（更新时间在卡片右上角的 wg_time，不在这里）。
                     整体从卡片内边距再往里推 4dp、往下推 1dp（车标格占位变高，收掉 2dp 保住整行高度），跟下面的续航区左端对齐。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 车标格 18dp 是**容器**、不是图形：留白由 WidgetMetrics.logoPad 收放，
                         1.0（默认）时图形仍是 14dp，左缘与车名基线都不动。 -->
                    <ImageView
                        android:id="@+id/wg_logo"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="1dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_logo_steering" />

                    <TextView
                        android:id="@+id/wg_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="我的爱车"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 续航：纯电一行；增程多一行油（wg_fuel_row 默认 GONE，纯电车型不占位）。
                     四件：图标（定宽 15dp）· 里程 · 条 · 百分比，整行**靠左对齐** —— 与零控首页 MileageRow 一致
                     （2026-11-10 用户对比首页后要求：「按照零控首页的效果来，续航靠左对齐」）。
                     里程是**一个** TextView：「195km」数字与单位连写、贴列左缘起排，
                     不再拆两格拉字距（那版两端对齐被用户判为「效果太差」）。
                     里程列 wrap_content + minWidth（窄版 46dp / 宽版 52dp，与 WidgetMetrics 常量一致）：
                     数字左缘、条的起点因此两行对齐；条 0dp + weight=1 吃剩余、百分比右对齐，
                     于是两条等长、百分号也落在同一条竖线上。
                     里程与条之间留 5dp 间隙。空间不够时只有条变短；字放大到超出里程列，
                     由 WidgetMetrics.numberSizeScale 按实测宽度收字号（不裁字，也不会把条挤没）。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/wg_ev_icon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_range_ev" />

                        <TextView
                            android:id="@+id/wg_ev_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:minWidth="46dp"
                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="--"
                            android:autoSizeTextType="none"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                        <!-- 条的「槽」：定高 12dp，实际粗细由**这层盒子的上下内边距**收回
                             （见 WidgetMetrics.barPaddingPx）。内边距不能加在 ProgressBar 自己身上 ——
                             ProgressBar 只把 drawable 收到内容区顶部，条会整体上移 2~3dp，
                             文字一放大就和条不在同一条中线上（2026-11-09 用户截图反馈）。 -->
                        <FrameLayout
                            android:id="@+id/wg_ev_bar_box"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="12dp"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="2dp">

                            <ProgressBar
                                android:id="@+id/wg_ev_bar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progressDrawable="@drawable/widget_bar_ev_glass" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/wg_ev_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:minWidth="34dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="--"
                            android:autoSizeTextType="none"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/wg_fuel_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/wg_fuel_icon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_range_fuel" />

                        <TextView
                            android:id="@+id/wg_fuel_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:minWidth="46dp"
                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="--"
                            android:autoSizeTextType="none"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                        <FrameLayout
                            android:id="@+id/wg_fuel_bar_box"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="12dp"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="2dp">

                            <ProgressBar
                                android:id="@+id/wg_fuel_bar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progressDrawable="@drawable/widget_bar_fuel_glass" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/wg_fuel_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:minWidth="34dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="--"
                            android:autoSizeTextType="none"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/wg_car_box"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/wg_car"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="车辆"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_act_row"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/wg_cell_unlock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_d"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wg_icon_unlock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="解锁"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qc_unlock" />
            </LinearLayout>

            <ImageView
                android:id="@+id/wg_div1"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#33FFFFFF"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/wg_cell_lock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_d"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wg_icon_lock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="上锁"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qc_lock" />
            </LinearLayout>

            <ImageView
                android:id="@+id/wg_div2"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#33FFFFFF"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/wg_cell_ac"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_d"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wg_icon_ac"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="空调"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qc_ac" />
            </LinearLayout>

            <ImageView
                android:id="@+id/wg_div3"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#33FFFFFF"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/wg_cell_trunk"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_d"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wg_icon_trunk"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="后备箱"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qc_trunk" />
            </LinearLayout>

            <ImageView
                android:id="@+id/wg_div4"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#33FFFFFF"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/wg_cell_horn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_d"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wg_icon_horn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="鸣笛寻车"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qc_horn" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 状态行：卡片右上角，压在照片上。
         照片深浅不可控，垫一层 widget_time_pill 薄黑底衬，白字才一直读得清 ——
         底衬挂在整行上（文案 + 刷新键共用同一个胶囊），而不是只包住文字。
         右边距比车模那一侧更宽：让它落在车模内侧，而不是贴着车模的右边缘。 -->
    <LinearLayout
        android:id="@+id/wg_status_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/widget_time_pill"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="5dp"
        android:paddingBottom="2dp">

        <!-- 状态图标（2026-11-20）：充电中闪电、解锁开锁、后备箱… 跟右边文字同色，
             由 VehicleWidget.bindLive 按 WidgetStatusText 给的语义设图与染色；
             更新时间 / 尚未同步这类提示不给图标，运行时 GONE。
             13dp 是量出来的：线稿图形只占 24 视口的 ~72%，乘下来正好 9.4dp，
             与旁边 10sp 的字等高；别再按「字号就是图标框」写成 10dp，那样图形只有 7dp。 -->
        <ImageView
            android:id="@+id/wg_hint_icon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_hint_ok"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wg_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:maxWidth="118dp"
            android:text="尚未同步"
            android:textColor="#E6FFFFFF"
            android:textSize="10sp" />

        <!-- 刷新键：20dp 的格子、2.5dp 内边距 → 图形 15dp（原来只有 11dp）。
             图形别直接等于格子：留一圈内边距，手指按在边角上也还在点击区内。 -->
        <ImageView
            android:id="@+id/wg_refresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="2dp"
            android:clickable="true"
            android:contentDescription="刷新车况"
            android:focusable="true"
            android:padding="2.5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>
</FrameLayout>
