<?xml version="1.0" encoding="utf-8"?>
<!--
  A｜素纸 · 5×2 宽版。

  和 4×2 那份是**同一个骨架**，只改了「宽出来那 80dp 往哪儿分」：
    · 内边距 end 11 → 13、车模区权重 1 → 1.2 —— 多出来的宽度主要给车模，
      它是这张卡的主体，跟着变宽比把它两侧留白更好看；
    · 信息区权重 1.06 → 1.1 —— 宽卡多出来的一格分给车模与续航行；
      续航的条本来就是 weight 吃满，宽卡上自动变长，不需要另写一套定宽；
    · 按键行 38 → 42dp —— 五个格子摊到 74dp 宽之后，不放高一点会显得图标孤零零。

  ⚠️ 改结构请**同时**改 widget_a.xml：这两份是同构的，
  分开维护是因为 RemoteViews 改不了 layout_weight（setInt 只认 @RemotableViewMethod），
  想让宽度按比例分配只能再来一份 XML。id 必须与 4×2 那份完全一致 ——
  增量更新（partiallyUpdateAppWidget）靠 id 定位，缺一个就静默失效。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_light"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingTop="9dp"
        android:paddingEnd="13dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/wg_hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/wg_info"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:orientation="vertical">

                <!-- 标题行：logo + 车名（更新时间在卡片右上角的 wg_time，不在这里）。
                     整体从卡片内边距再往里推 4dp、往下推 1dp（车标格占位变高，收掉 2dp 保住整行高度），跟下面的续航区左端对齐。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 车标格 18dp 是**容器**、不是图形：留白由 WidgetMetrics.logoPad 收放，
                         1.0（默认）时图形仍是 14dp，左缘与车名基线都不动。 -->
                    <ImageView
                        android:id="@+id/wg_logo"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="1dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_logo_steering" />

                    <TextView
                        android:id="@+id/wg_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="我的爱车"
                        android:textColor="#12141A"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 续航：纯电一行；增程多一行油（wg_fuel_row 默认 GONE，纯电车型不占位）。
                     四件：图标（定宽 15dp）· 里程 · 条 · 百分比，整行**靠左对齐** —— 与零控首页 MileageRow 一致
                     （2026-11-10 用户对比首页后要求：「按照零控首页的效果来，续航靠左对齐」）。
                     里程是**一个** TextView：「195km」数字与单位连写、贴列左缘起排，
                     不再拆两格拉字距（那版两端对齐被用户判为「效果太差」）。
                     里程列 wrap_content + minWidth（窄版 46dp / 宽版 52dp，与 WidgetMetrics 常量一致）：
                     数字左缘、条的起点因此两行对齐；条 0dp + weight=1 吃剩余、百分比右对齐，
                     于是两条等长、百分号也落在同一条竖线上。
                     里程与条之间留 5dp 间隙。空间不够时只有条变短；字放大到超出里程列，
                     由 WidgetMetrics.numberSizeScale 按实测宽度收字号（不裁字，也不会把条挤没）。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/wg_ev_icon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_range_ev" />

                        <TextView
                            android:id="@+id/wg_ev_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:minWidth="52dp"
                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="--"
                            android:autoSizeTextType="none"
                            android:textColor="#12141A"
                            android:textSize="13sp" />

                        <!-- 条的「槽」：定高 12dp，实际粗细由**这层盒子的上下内边距**收回
                             （见 WidgetMetrics.barPaddingPx）。内边距不能加在 ProgressBar 自己身上 ——
                             ProgressBar 只把 drawable 收到内容区顶部，条会整体上移 2~3dp，
                             文字一放大就和条不在同一条中线上（2026-11-09 用户截图反馈）。 -->
                        <FrameLayout
                            android:id="@+id/wg_ev_bar_box"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="12dp"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="2dp">

                            <ProgressBar
                                android:id="@+id/wg_ev_bar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progressDrawable="@drawable/widget_bar_ev" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/wg_ev_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:minWidth="34dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="--"
                            android:autoSizeTextType="none"
                            android:textColor="#12141A"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/wg_fuel_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/wg_fuel_icon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_range_fuel" />

                        <TextView
                            android:id="@+id/wg_fuel_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:minWidth="52dp"
                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="--"
                            android:autoSizeTextType="none"
                            android:textColor="#12141A"
                            android:textSize="13sp" />

                        <FrameLayout
                            android:id="@+id/wg_fuel_bar_box"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="12dp"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="2dp">

                            <ProgressBar
                                android:id="@+id/wg_fuel_bar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progressDrawable="@drawable/widget_bar_fuel" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/wg_fuel_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:minWidth="34dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="--"
                            android:autoSizeTextType="none"
                            android:textColor="#12141A"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/wg_car_box"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2">

                <ImageView
                    android:id="@+id/wg_car"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="车辆"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_act_row"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/wg_cell_unlock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_a"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wg_icon_unlock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="解锁"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qc_unlock" />
            </LinearLayout>

            <ImageView
                android:id="@+id/wg_div1"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#1412141A"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/wg_cell_lock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_a"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wg_icon_lock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="上锁"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qc_lock" />
            </LinearLayout>

            <ImageView
                android:id="@+id/wg_div2"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#1412141A"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/wg_cell_ac"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_a"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wg_icon_ac"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="空调"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_ac_fan" />
            </LinearLayout>

            <ImageView
                android:id="@+id/wg_div3"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#1412141A"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/wg_cell_trunk"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_a"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wg_icon_trunk"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="后备箱"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qc_trunk" />
            </LinearLayout>

            <ImageView
                android:id="@+id/wg_div4"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#1412141A"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/wg_cell_horn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_a"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wg_icon_horn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="鸣笛寻车"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qc_horn" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 状态行：卡片右上角，浮在车模之上。
         写成根 FrameLayout 的子视图（而不是塞进标题行），位置才不受车名长短影响。
         右边距比车模那一侧更宽：让它落在车模内侧，而不是贴着车模的右边缘。

         一行里放「状态文案 + 刷新按钮」：刷新键固定在右端，文案往左生长，
         所以文案用 maxWidth 卡住（太长就省略号），不会把刷新键挤出卡片。
         这块自己不可点击，点空白处仍然落到底下的车模 / 文字区（打开 App）。 -->
    <LinearLayout
        android:id="@+id/wg_status_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <!-- 状态图标（2026-11-20）：充电中闪电、解锁开锁、后备箱… 跟右边文字同色，
             由 VehicleWidget.bindLive 按 WidgetStatusText 给的语义设图与染色；
             更新时间 / 尚未同步这类提示不给图标，运行时 GONE。
             13dp 是量出来的：线稿图形只占 24 视口的 ~72%，乘下来正好 9.4dp，
             与旁边 10sp 的字等高；别再按「字号就是图标框」写成 10dp，那样图形只有 7dp。 -->
        <ImageView
            android:id="@+id/wg_hint_icon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_hint_ok"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wg_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:maxWidth="118dp"
            android:text="尚未同步"
            android:textColor="#8A9099"
            android:textSize="10sp" />

        <!-- 刷新键：20dp 的格子、2.5dp 内边距 → 图形 15dp（原来只有 11dp）。
             图形别直接等于格子：留一圈内边距，手指按在边角上也还在点击区内，
             所以看着「略微大一点」，实际点击区比看起来还宽一圈。 -->
        <ImageView
            android:id="@+id/wg_refresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="3dp"
            android:clickable="true"
            android:contentDescription="刷新车况"
            android:focusable="true"
            android:padding="2.5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>
</FrameLayout>
