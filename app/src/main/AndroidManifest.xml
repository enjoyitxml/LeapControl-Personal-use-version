<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 蓝牙钥匙后台保活：以 connectedDevice 前台服务常驻，开机 / 升级后自动恢复 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!--
      后台定时采样（行程 trip/TripRecordService 与充电 journal/ChargeWatchService）：
      dataSync 前台服务常驻。行程间隔由用户设定，充电固定 1 分钟、捕捉到停止充电立刻全停。
      Android 14 起这类服务必须单独申请权限。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 服务被清掉时靠精确闹钟兜底；Doze 下请求要跑完，所以还要唤醒锁 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 引导用户把零控加进「不受电池优化限制」，否则国产 ROM 的省电策略会掐掉后台 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- osmdroid 的清单默认要这个（它默认把瓦片缓存写到外部存储根目录）。
         我们已经把缓存指到 filesDir（见 FindCarMap 的 ensureMapConfig），用不到它，
         从合并结果里去掉，别让「权限」列表平白多一条 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <!-- 应用内下载新版本后直接唤起系统安装器（Android 8+ 还需用户在系统里授权一次） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 「支持开发者」页把收款码存到相册：Android 10 起走 MediaStore 不需要权限，
         只有 Android 8 / 9 要这一条，所以声明到 28 为止（新系统上不会出现在权限列表里） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 语音记账：灵感球长按说话走进程内 SpeechRecognizer（要自己画 Siri 式浮层），
         系统语音 App 那条路做不到自绘界面，所以必须自己申请麦克风 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+ 包可见性：不加这段 isRecognitionAvailable() 会恒返回 false -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".LeapApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.LeapControl"
        android:usesCleartextTraffic="true">

        <!--
          主界面自身不再声明 LAUNCHER：桌面图标由下面两个 activity-alias 承载，
          靠 PackageManager.setComponentEnabledSetting 二选一启用，实现「换图标」。

          为什么这么做：adaptive icon 的图是编译期资源，运行时改不了；
          只能预置两套 alias，切换时启用其一、禁用另一个，桌面图标随之变化。
          （用户选的样式存在 SessionStore，切换后提示用户重启 App 生效。）
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 方向盘（不带品牌标识）：个人学习版**只**保留这一个，由 gradle 占位符打开 -->
        <activity-alias
            android:name=".LauncherSteering"
            android:enabled="${steeringIconEnabled}"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          默认：零跑官方 logo（与官方 App 观感一致；2026-11-09 起作为默认图标）。
          个人学习版的构建属性会把它默认关掉（`officialIconEnabled=false`），
          桌面图标只剩方向盘那一个，个性化里也不再提供切换入口。
        -->
        <activity-alias
            android:name=".LauncherOfficial"
            android:enabled="${officialIconEnabled}"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_official"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_official_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:label="崩溃信息"
            android:theme="@style/Theme.LeapControl" />

        <!-- 更新包在 filesDir/update/ 里，安装时要通过 content:// 交给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          桌面小组件的自定义背景图。
          必须是 exported：读图的是桌面（另一个进程），它只拿得到 content:// 这条 URI。
          提供者内部只按「当前版本号」精确匹配文件名，不接受任意路径。
        -->
        <provider
            android:name=".widget.WidgetWallpaperProvider"
            android:authorities="${applicationId}.widgetwall"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!--
          桌面小组件（4×2）：续航 / 车况 / 五个控车按键。
          标准 AppWidgetProvider —— 澎湃「原生小部件」要上架小米商店 + 白名单，侧载包做不到，
          所以走安卓通用小组件。三套版式由用户选择，见 widget/VehicleWidget.kt 顶部说明。
        -->
        <receiver
            android:name=".widget.VehicleWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!--
                  升级 APK 后桌面上已有的卡片仍是旧包里那套 RemoteViews，
                  不重新推一次的话，这一版改过的版式 / 图标要等用户删掉重加才看得到。
                -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!--
          桌面小组件（5×2 宽版，2026-11-06）：给 5 列的桌面用 —— 4×2 摆上去会空一列。
          逻辑与上面那个完全共用（子类一行都没重写），只是多一个「添加小部件」条目、
          多一套 widget_*_wide 布局。label 必须与 4×2 区分开，否则列表里两个「零控」分不清。
        -->
        <receiver
            android:name=".widget.VehicleWidgetProviderWide"
            android:exported="true"
            android:label="@string/widget_label_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_wide" />
        </receiver>

        <!--
          充电期间的采样：只在 chargeState∈{1,5} 时存在，捕捉到停止充电立刻撤闹钟、
          停前台服务，之后不再拉车况。闹钟 / 服务 / 开机恢复都用显式广播，不导出。
        -->
        <receiver
            android:name=".journal.ChargeSampleReceiver"
            android:exported="false" />

        <service
            android:name=".journal.ChargeWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".journal.ChargeBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 蓝牙钥匙后台服务：连接车辆、维持无感解锁所需的 BLE 链路 -->
        <service
            android:name=".bluetooth.BleKeyService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
          行程记录期间的采样服务：用户点「开始记录」才启动，结束 / 暂停 / 自动收尾立刻停。
          常驻通知是前台服务的代价，也是用户能看见「正在记录」的凭证。
        -->
        <service
            android:name=".trip.TripRecordService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 采样闹钟：服务被 OEM 清理后的兜底，与前台服务共用同一份采样逻辑 -->
        <receiver
            android:name=".trip.TripSampleAlarmReceiver"
            android:exported="false" />

        <!-- 开机 / 升级后把还在记录的那一趟接上（只排闹钟，不起前台服务） -->
        <receiver
            android:name=".trip.TripBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 开机 / 应用升级后自动恢复后台蓝牙钥匙 -->
        <receiver
            android:name=".bluetooth.BleKeyBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 系统控制中心快捷磁贴（ACTIVE_TILE：点击即在应用内执行，不折叠面板） -->
        <service
            android:name=".tiles.LockTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_lock"
            android:label="上锁"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.UnlockTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_unlock"
            android:label="解锁"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.HornTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_horn"
            android:label="鸣笛寻车"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.ClimateTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_ac"
            android:label="空调"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.TrunkTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_trunk"
            android:label="后备箱"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.WindowTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_window"
            android:label="车窗"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.BatteryHeatTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_battery_heat"
            android:label="电池预热"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.SunshadeTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_sunshade"
            android:label="遮阳帘"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
    </application>

</manifest>
